# Copy to .env.local for `npm run dev`, and add the same names in Vercel → Settings → Environment Variables.
# Every feature is optional: without its settings, that feature shows a "not set up yet" message.

# --- Firebase (sign-in, the shared plant library, account records) ---
# Browser config from Firebase console → Project settings → Your apps → Web app. Safe to expose.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server credentials: Project settings → Service accounts → Generate new private key. Secret.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the key on one line with \n for line breaks, in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Claude (plant research) --- Secret. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Stripe (the $3/month Garden plan) --- Secret. Use test keys (sk_test_...) outside production.
STRIPE_SECRET_KEY=sk_test_
STRIPE_PRICE_ID=price_
STRIPE_WEBHOOK_SECRET=whsec_
# The site's public address, used for Stripe's return links. No trailing slash.
APP_URL=http://localhost:3000

# --- Limits ---
FREE_LOOKUPS_PER_MONTH=5
