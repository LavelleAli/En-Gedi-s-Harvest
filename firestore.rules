rules_version = '2';
// The browser never reads or writes Firestore directly: every read and write goes through the
// site's API (backend/), which uses the Firebase Admin SDK and isn't bound by these rules.
// Denying all client access means a leaked web config can't touch account or plant data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
